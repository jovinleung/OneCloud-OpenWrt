#!/bin/sh
# OneCloud bypass router network setup
# Runs on first boot, sets static IP and disables DHCP server

# Set LAN interface to static IP (CIDR format like working firmware)
uci set network.lan.proto='static'
uci delete network.lan.ipaddr 2>/dev/null
uci add_list network.lan.ipaddr='192.168.2.2/24'
uci set network.lan.gateway='192.168.2.1'
uci delete network.lan.dns 2>/dev/null
uci add_list network.lan.dns='192.168.2.1'
uci set network.lan.ip6assign='60'
uci set network.lan.multipath='off'

# Set br-lan MAC address (fixed MAC for stability)
uci set network.@device[0].macaddr='02:81:4b:1a:2c:3d'

# Disable DHCP server on LAN (bypass router mode)
# ignore=1 disables DHCPv4; dhcpv6/ra disabled to avoid conflict with main router
uci set dhcp.lan.ignore='1'
uci set dhcp.lan.dhcpv6='disabled'
uci set dhcp.lan.ra='disabled'

# Firewall: bypass mode (single arm)
uci set firewall.@defaults[0].forward='ACCEPT'
uci set firewall.@defaults[0].flow_offloading='1'
uci set firewall.@defaults[0].flow_offloading_hw='0'
uci set firewall.@defaults[0].fullcone='1'
uci set firewall.@defaults[0].fullcone6='0'
uci set firewall.@defaults[0].syn_flood='1'

uci commit network
uci commit dhcp
uci commit firewall

exit 0
