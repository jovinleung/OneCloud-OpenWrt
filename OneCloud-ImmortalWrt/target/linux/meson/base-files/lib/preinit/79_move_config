move_config() {
	local partdev
	if export_partdevice partdev 1; then
		mount -o rw,noatime "/dev/$partdev" /mnt 2>/dev/null
		if [ -f /mnt/sysupgrade.tgz ]; then
			mv -f /mnt/sysupgrade.tgz /
		fi
		umount /mnt 2>/dev/null
	fi
}

boot_hook_add preinit_mount_root move_config
